{
  "name": "jabama-jajiga-crawler",
  "version": "1.0.0",
  "description": "A crawler to scrape and compare listings from jabama.com and jajiga.com",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "crawl": "npm run build && npm start",
    "detect-api": "tsx src/index.ts --detect-api",
    "crawl:browser": "tsx src/index.ts",
    "crawl:manual": "tsx src/index.ts",
    "crawl:http": "tsx src/index.ts"
  },
  "keywords": ["crawler", "scraper", "jabama", "jajiga"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "p-limit": "^5.0.0",
    "puppeteer": "^21.6.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "https-proxy-agent": "^7.0.2",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tough-cookie": "^4.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
